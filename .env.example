# Copy only the settings you need into your shell environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=512
OPENAI_REQUEST_TIMEOUT=30

ROBOT_PROFILE=mobile
ROBOT_NAMES=yolobot,turtle2,minipupper
LLM_CHAT_HISTORY_MAX_ITEMS=100

AUDIO_RECORD_SECONDS=5
AUDIO_SAMPLE_RATE=16000
AUDIO_GAIN=1.0
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=en

# AWS credentials should come from `aws configure`, an IAM role, or another
# standard provider in the boto3 credential chain.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_TRANSCRIBE_LANGUAGE=en-US
AWS_POLLY_VOICE_ID=Ivy
